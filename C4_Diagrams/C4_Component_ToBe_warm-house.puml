@startuml
!theme C4_sandstone from <C4/themes>
!include Templates/C4_Component.puml
title "Component diagrams: Тёплый дом"

SHOW_PERSON_OUTLINE()
LAYOUT_LANDSCAPE()

Person(user, "User", "Пользователь")

Enterprise_Boundary(smart_house_system, "Домен: Умный дом") {

    Container(web_app, "Web Application", "", "Веб-приложение")
    
    System_Boundary(subdomen_device_management, "Подомен: Управление устройствами") {
        Container_Boundary(context_device_management, "Контекст (микросервис): Управление устройствами") {  
            Component(device_management_controller, "Api Controller", "Go", "Контроллер")
            Component(device_management_service, "Device management Service", "Go", "Управляет устройствами")
            
            Component(command_handler_service, "Command handler Service", "Go", "Обрабатывает команды")
            Component(device_status_manager_service, "Device status manager Service", "Go", "Менеджер состояния устройств")

        }    
             
        ContainerDb(device_management_database_service, "Database", "PostgreSQL", "Хранит информацию")
        SystemQueue(device_management_message_queue, "API Application", "Очередь для высоконагруженных систем и потоковой обработки событий", "Apache Kafka")
        
        Rel(device_management_controller, device_management_service, "Использует")
        Rel(device_management_service, device_management_database_service, "Читает и записывает")
    }
    

    System_Boundary(subdomen_user_management, "Подомен: Управление пользователями") {
        Container(user_management_api_application, "API Application", "Go", "Предоставляет функции через API")
        ContainerDb(user_management_database_service, "Database", "PostgreSQL", "Хранит информацию")

        Rel(user_management_api_application, user_management_database_service, "Читает и записывает")
    }

    System_Boundary(subdomen_house_management, "Подомен: Управление домами") {
        Container(house_management_api_application, "API Application", "Go", "Предоставляет функции через API")
        ContainerDb(house_management_database_service, "Database", "PostgreSQL", "Хранит информацию")

        Rel(house_management_api_application, house_management_database_service, "Читает и записывает")
    }

    Rel(user, web_app, "Использует")
    Rel(web_app, device_management_controller, "Использует")
    Rel(web_app, user_management_api_application, "Использует")
    Rel(web_app, house_management_api_application, "Использует")
}

Boundary(house, "Дом") {
    System_Ext(home_device_management_api_application, "Сервис управления устройствами в доме", "Предоставляет функции через API")
}

Rel(context_device_management, home_device_management_api_application, "Управляет устройствами в доме")


' - **Домен: &laquo;Управление пользователями&raquo;**
'   - контекст: управление пользователями
' - **Домен: &laquo;Управление домами&raquo;**
'   - контекст: управление домами
' - **Домен: &laquo;Умный дом&raquo;**
'   - контекст: управление пользователями и домами
'   - контекст: включение/выключение отопления в доме
'   - контекст: просмотр температуры в доме

@enduml